# Copie para .env se quiser mudar algo; sem .env, o servidor usa estes mesmos valores.
# Credenciais só de desenvolvimento local (docker-compose.yml).
DATABASE_URL=postgres://jogo:jogo_local@localhost:5433/jogo
DATABASE_URL_TESTE=postgres://jogo:jogo_local@localhost:5433/jogo_teste
PORTA=3000
# 1 liga as rotas de desenvolvimento (/v1/dev/...): criar contas de teste, creditar ouro, reconciliar.
JOGO_DEV=1
